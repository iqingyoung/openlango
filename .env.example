# 复制为 .env 后按所选 provider 填写；config/openlango.config.yaml 通过 env 名称引用
# OpenAI 兼容（DeepSeek/Qwen/GLM/OpenAI 等共用）
OPENLANGO_LLM_BASE_URL=https://api.deepseek.com/v1
OPENLANGO_LLM_API_KEY=
OPENLANGO_LLM_MODEL=deepseek-chat

# Ollama 本地（零成本路径）
OPENLANGO_OLLAMA_BASE_URL=http://localhost:11434
OPENLANGO_OLLAMA_MODEL=qwen3:8b

# 语音（M2）：ASR 用 Groq 免费档（console.groq.com 领 key）或任意 whisper 兼容端点
OPENLANGO_ASR_BASE_URL=https://api.groq.com/openai/v1
OPENLANGO_ASR_API_KEY=

# 语音（M2）：TTS 默认 msedge 免费音色，无需 key；换 openai-speech 时填以下两项
OPENLANGO_TTS_API_KEY=
